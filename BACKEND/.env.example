# =============================================================
# StartCode Panel — Backend
# Copia este archivo como .env y completa los valores
# =============================================================

# -------------------------------------------------------------
# Aplicación
# -------------------------------------------------------------

# Entorno de ejecución: development | production | test
# En development: TypeORM activa synchronize y logging automáticamente
NODE_ENV=development

# Puerto en el que escucha NestJS
PORT=3001

# Nombre que aparece en la app de autenticación al activar 2FA
APP_NAME=StartCode Panel

# Orígenes permitidos para CORS (separados por coma si son varios)
# En development puedes usar * para permitir todos
# En production usa la URL exacta del frontend web. Los orígenes de la app de
# escritorio (tauri://localhost, http(s)://tauri.localhost) se añaden solos.
CORS_ORIGIN=http://localhost:5173

# -------------------------------------------------------------
# Base de datos (PostgreSQL)
# -------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_password
DB_NAME=startcode_panel

# -------------------------------------------------------------
# JWT — Autenticación de usuarios
# -------------------------------------------------------------

# Clave secreta para firmar los tokens. Usa una cadena larga y aleatoria.
# Ejemplo para generar: openssl rand -hex 64
JWT_SECRET=cambia_este_secret_por_uno_seguro_de_64_caracteres_minimo

# Duración del access token (usuarios del panel)
# Formatos válidos: 30m, 1h, 7d
JWT_EXPIRES_IN=30m

# Duración del refresh token
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# Duración del token de agente (agentes de monitoreo)
# Los agentes son procesos de larga duración, token anual recomendado
AGENT_TOKEN_EXPIRES_IN=365d

# Duración del token con el que el servidor remoto descarga el agente al instalarlo
AGENT_INSTALL_TOKEN_EXPIRES_IN=5m

# -------------------------------------------------------------
# Bases de datos externas (tab Bases de Datos)
# -------------------------------------------------------------

# Clave AES-256 con la que se cifran las contraseñas de las conexiones.
# 32 bytes en hex (64 caracteres) o base64. Generar: openssl rand -hex 32
# Si cambia, las contraseñas guardadas dejan de poder descifrarse.
DB_CREDENTIALS_KEY=

# -------------------------------------------------------------
# Usuario administrador inicial
# Se crea al arrancar si no existe. Cambia la contraseña tras el primer login.
# -------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@startcode.local
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_FIRSTNAME=Admin
DEFAULT_ADMIN_LASTNAME=System

# -------------------------------------------------------------
# Redis — Caché
# -------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379

# Dejar vacío si Redis no tiene contraseña
REDIS_PASSWORD=

# Número de base de datos Redis (0-15)
REDIS_DB=0

# TTL por defecto del caché en segundos
REDIS_TTL=300

# -------------------------------------------------------------
# Instalación remota del agente
# URL por la que los SERVIDORES MONITORIZADOS alcanzan al panel.
# No es la del navegador: si abres el panel en localhost, desde el
# servidor remoto eso no lleva a ninguna parte.
# -------------------------------------------------------------
PANEL_PUBLIC_URL=http://localhost:3001
# Opcional: si el WebSocket del agente no cuelga de PANEL_PUBLIC_URL
# PANEL_AGENT_WS_URL=ws://localhost:3001/agent
# Dónde están los artefactos publicados con `make release` (por defecto ./agent-dist)
# AGENT_DIST_DIR=

# -------------------------------------------------------------
# SFTP
# -------------------------------------------------------------
# Cierre de una sesión sin actividad (ms; 600000 = 10 min)
SFTP_IDLE_TIMEOUT_MS=600000
# Sesiones SFTP abiertas a la vez por usuario
SFTP_MAX_SESSIONS_PER_USER=3
# Tamaño máximo de un archivo subido (bytes; 2147483648 = 2 GB)
SFTP_MAX_UPLOAD_BYTES=2147483648
