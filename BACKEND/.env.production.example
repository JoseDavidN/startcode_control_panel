# =============================================================
# StartCode Panel — Backend en producción (docker compose)
# Copia como .env.production, completa y no lo subas al repositorio.
# Generar secretos:  openssl rand -hex 32   /   openssl rand -hex 64
# =============================================================

# NODE_ENV=production y PORT=3001 los fija docker-compose.yml.

# -------------------------------------------------------------
# Imagen (Docker Hub)
# -------------------------------------------------------------
# Usuario u organización de Docker Hub: la imagen es <DOCKERHUB_USER>/startcode-panel-backend
DOCKERHUB_USER=
# Versión publicada (la de BACKEND/package.json) o latest
BACKEND_TAG=0.9.1

# Puerto publicado en el host (con proxy inverso, cambia el mapeo a 127.0.0.1 en el compose)
API_PORT=3001

APP_NAME=StartCode Panel

# URL exacta del frontend web; los orígenes de la app de escritorio se añaden solos.
# Varios, separados por coma. No usar * en producción.
CORS_ORIGIN=https://panel.example.com

# -------------------------------------------------------------
# PostgreSQL
# Base existente: su host y puerto. Vacíos, la del compose (--profile db).
# -------------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=startcode_panel
DB_USERNAME=startcode
DB_PASSWORD=cambia_esta_password
# Solo con --profile db: volumen externo de Docker con los datos (crearlo antes, ver DEPLOY.md)
DB_VOLUME=startcode-pgdata

# -------------------------------------------------------------
# Redis (solo caché)
# Existente: su host y puerto. Vacíos, el del compose (--profile cache).
# -------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=cambia_esta_password
REDIS_DB=0
REDIS_TTL=300

# -------------------------------------------------------------
# JWT
# -------------------------------------------------------------
JWT_SECRET=genera_uno_con_openssl_rand_hex_64
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
AGENT_TOKEN_EXPIRES_IN=365d
AGENT_INSTALL_TOKEN_EXPIRES_IN=5m

# -------------------------------------------------------------
# Contraseñas de las conexiones a bases de datos (AES-256)
# 32 bytes en hex: openssl rand -hex 32
# NO cambiarla después: las contraseñas guardadas dejarían de poder descifrarse.
# -------------------------------------------------------------
DB_CREDENTIALS_KEY=

# -------------------------------------------------------------
# Administrador inicial (se crea al primer arranque si no existe).
# Cambia la contraseña tras el primer inicio de sesión.
# -------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=cambia_esta_password
DEFAULT_ADMIN_FIRSTNAME=Admin
DEFAULT_ADMIN_LASTNAME=System

# -------------------------------------------------------------
# Agente de monitoreo
# URL por la que los SERVIDORES MONITORIZADOS alcanzan al panel (no la del navegador).
# -------------------------------------------------------------
PANEL_PUBLIC_URL=https://api.panel.example.com
# PANEL_AGENT_WS_URL=wss://api.panel.example.com/agent

# -------------------------------------------------------------
# SFTP
# -------------------------------------------------------------
SFTP_IDLE_TIMEOUT_MS=600000
SFTP_MAX_SESSIONS_PER_USER=3
SFTP_MAX_UPLOAD_BYTES=2147483648
