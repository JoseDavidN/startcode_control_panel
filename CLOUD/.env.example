# ── StartCode Cloud ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3100

# Orígenes del panel web separados por comas (`*` para cualquiera). Los de
# la app de escritorio (Tauri) se añaden siempre.
CORS_ORIGIN=http://localhost:5173

# Firma de los tokens de sesión. Al menos 32 caracteres aleatorios:
#   openssl rand -base64 48
CLOUD_JWT_SECRET=
# Duración de cada sesión del panel (formato ms/vercel: 180d, 12h…).
CLOUD_TOKEN_TTL=180d

# Estado interno (usuarios y sesiones, en JSON). Fuera del almacenamiento.
CLOUD_DATA_DIR=./data

# Carpetas dentro de las que el panel puede poner Home y Backups, separadas
# por comas. El panel nunca puede apuntar la nube fuera de ellas.
CLOUD_ALLOWED_ROOTS=./storage
# Rutas iniciales de cada usuario (si no, <primera carpeta permitida>/home y /backups).
CLOUD_DEFAULT_HOME=
CLOUD_DEFAULT_BACKUPS=

# Primer usuario: se crea al arrancar si aún no hay ninguno. Más usuarios:
#   pnpm user:add <usuario>
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=

# Límites
CLOUD_MAX_UPLOAD_BYTES=20gb
CLOUD_TREE_MAX_ENTRIES=50000

# Video: cualquier formato con ffmpeg (la imagen Docker ya lo trae).
# Rutas si no están en el PATH.
CLOUD_FFMPEG_PATH=
CLOUD_FFPROBE_PATH=
# Conversiones a H.264 a la vez (las pesadas; re-empaquetar no cuenta).
CLOUD_MAX_TRANSCODES=2
# Hilos por conversión (vacío: la mitad de los núcleos, mínimo 2).
CLOUD_TRANSCODE_THREADS=
# Alto máximo al convertir: lo más grande se reduce. 720 va fluido incluso en
# servidores de 2 núcleos; 1080 pide más CPU.
CLOUD_TRANSCODE_MAX_HEIGHT=720
# Velocidad de x264: ultrafast (menos CPU, archivos más grandes) … medium.
CLOUD_TRANSCODE_PRESET=superfast
# Videos ya convertidos que se guardan para no repetir el trabajo (0 lo desactiva).
CLOUD_MEDIA_CACHE_BYTES=10gb
# Por defecto, <CLOUD_DATA_DIR>/media-cache.
CLOUD_MEDIA_CACHE_DIR=
