# =============================================================
# StartCode Cloud — producción (docker compose)
# Copia como .env.production, completa y no lo subas al repositorio.
# =============================================================

# NODE_ENV=production, PORT=3100, CLOUD_DATA_DIR=/data y
# CLOUD_ALLOWED_ROOTS=/storage los fija docker-compose.yml.

# -------------------------------------------------------------
# Imagen (Docker Hub)
# -------------------------------------------------------------
# Usuario u organización de Docker Hub: la imagen es <DOCKERHUB_USER>/startcode-cloud
DOCKERHUB_USER=
# Versión publicada (la de CLOUD/package.json), X.Y para seguir sus parches, o latest
CLOUD_TAG=0.2.2

# Puerto publicado en el host (con proxy inverso, cambia el mapeo a 127.0.0.1 en el compose)
CLOUD_PORT=3100

# Volúmenes externos de Docker (crearlos antes: docker volume create <nombre>)
# Estado interno, montado en /data
CLOUD_DATA_VOLUME=startcode-cloud-data
# Archivos de Home y Backups, montado en /storage
CLOUD_STORAGE_VOLUME=startcode-cloud-storage

# Orígenes del panel web separados por comas. Los de la app de escritorio se añaden siempre.
CORS_ORIGIN=https://panel.example.com

# Firma de los tokens de sesión (al menos 32 caracteres): openssl rand -base64 48
CLOUD_JWT_SECRET=
CLOUD_TOKEN_TTL=180d

# Rutas iniciales de cada usuario, dentro de /storage (si no, /storage/home y /storage/backups).
CLOUD_DEFAULT_HOME=
CLOUD_DEFAULT_BACKUPS=

# Primer usuario: se crea al arrancar si aún no hay ninguno. Más usuarios:
#   docker compose --env-file .env.production exec cloud node dist/cli/user-add <usuario>
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=

# Límites
CLOUD_MAX_UPLOAD_BYTES=20gb
CLOUD_TREE_MAX_ENTRIES=50000

# Video (la imagen trae ffmpeg)
CLOUD_MAX_TRANSCODES=2
CLOUD_TRANSCODE_THREADS=
CLOUD_TRANSCODE_MAX_HEIGHT=720
CLOUD_TRANSCODE_PRESET=superfast
CLOUD_MEDIA_CACHE_BYTES=10gb
