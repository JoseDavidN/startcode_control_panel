# =============================================================
# StartCode Panel — Frontend
# Copia este archivo como .env.local para desarrollo local
# o como .env.production para el build de producción/Tauri
# =============================================================

# -------------------------------------------------------------
# Backend
# URL base del API REST de NestJS (sin slash final)
# -------------------------------------------------------------

# Desarrollo local
VITE_API_URL=http://localhost:3001/api/v1

# Producción / app Tauri conectada a servidor remoto
# VITE_API_URL=https://tu-servidor.com:3001/api/v1

# -------------------------------------------------------------
# WebSockets
# URL del servidor de WebSockets (normalmente el mismo que el API)
# Debe ser la misma dirección que VITE_API_URL
# -------------------------------------------------------------

VITE_WS_URL=http://localhost:3001

# Producción / app Tauri
# VITE_WS_URL=https://tu-servidor.com:3001
