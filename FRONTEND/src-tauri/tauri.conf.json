{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StartCode Panel",
  "version": "0.12.0",
  "identifier": "com.startcode.panel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "StartCode Panel",
        "width": 1600,
        "height": 900,
        "minWidth": 1600,
        "minHeight": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob: http://*:* https://*:*; connect-src 'self' http://*:* https://*:* ws://*:* wss://*:*; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3OEQyNEI2MUE5NDQ3NTAKUldSUVI1UWF0aVNOWnp2c1NIY0c0dkp1VEdEczVyRHRqaXU4bTN6ay8rd0djSnJGQ2NhaVNyU1kK",
      "endpoints": [
        "https://releases.startcode.com.co/startcode-panel/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "StartCode",
    "shortDescription": "Panel de control de servidores",
    "longDescription": "StartCode Panel: monitorización, terminal, archivos, bases de datos y servicios de tus servidores desde el escritorio.",
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
