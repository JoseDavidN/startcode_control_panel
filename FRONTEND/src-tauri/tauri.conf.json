{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StartCode Panel",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "StartCode Panel",
        "width": 1600,
        "height": 900,
        "minWidth": 1600,
        "minHeight": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://* https://* ws://* wss://*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REEMPLAZAR: ejecutar 'pnpm tauri signer generate -w ~/.tauri/startcode.key' y pegar aquí la clave pública",
      "endpoints": [
        "https://releases.startcode.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": false,
      "windows": {
        "installerArgs": ["/S"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
